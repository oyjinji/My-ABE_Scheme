__pycache__/
*.pyc
*.pyo
*.Zone.Identifier
*:Zone.Identifier

# 临时 / 草稿运行目录（冻结的 results 仍入库，见根 README 的 "Results and
# provenance policy" 一节）。index_v2 一类的套件用时间戳生成 run id，其草稿
# 目录不匹配此模式，验证完需自行删除。
src/**/results/scratch*/
src/**/logs/*.tmp

# 根级共享工作区（DACP 数据集实验），内容不入库。
# shared/data/ 保留 .gitkeep 目录占位；shared/results/ 不保留——写出方
# （src/core/dacp/data/paths.py 及各 run_dacp_* 脚本）运行时会自建目录，
# 故此处只忽略内容，不设反忽略规则。
shared/data/raw/*
shared/data/work/*
shared/data/encrypted/*
shared/data/recovered/*
shared/data/products/*
shared/results/dacp_data/*
shared/results/dacp_marketplace/*
shared/results/dacp_marketplace/credit_fraud/*
!shared/data/raw/.gitkeep
!shared/data/work/.gitkeep
!shared/data/encrypted/.gitkeep
!shared/data/recovered/.gitkeep
!shared/data/products/.gitkeep
!shared/results/dacp_marketplace/credit_fraud/.gitkeep

# matplotlib 字体缓存（曾误入库）
.mplconfig/
src/**/.mplconfig/
/artifacts/myabe08/
