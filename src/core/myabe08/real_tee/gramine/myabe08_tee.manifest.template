# SGX_DEBUG_GRAMINE_V1. DEBUG/TEST ONLY; no RA or durable rollback protection.
# Fixed measured Python module entrypoint. RPC payloads are data, never code.
libos.entrypoint = "/usr/bin/python3.8"
loader.argv = ["python3.8", "-B", "-m", "core.myabe08.real_tee.service"]
loader.insecure__use_cmdline_argv = false
loader.log_level = "error"
loader.env.LD_LIBRARY_PATH = "/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"
loader.env.PYTHONPATH = "/app:{{ site }}"
loader.env.PYTHONDONTWRITEBYTECODE = "1"
loader.env.MYABE08_SGX_DEBUG_TEST_MODE = "1"

fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/lib/x86_64-linux-gnu", uri = "file:/lib/x86_64-linux-gnu" },
  { path = "/usr/lib/x86_64-linux-gnu", uri = "file:/usr/lib/x86_64-linux-gnu" },
  { path = "/usr/lib/python3.8", uri = "file:/usr/lib/python3.8" },
  { path = "/usr/bin/python3.8", uri = "file:/usr/bin/python3.8" },
  { path = "{{ site }}", uri = "file:{{ site }}" },
  { path = "/app/core/__init__.py", uri = "file:{{ repo }}/src/core/__init__.py" },
  { path = "/app/core/myabe08", uri = "file:{{ repo }}/src/core/myabe08" },
  { type = "tmpfs", path = "/tmp" },
]

sys.stack.size = "2M"
sgx.debug = true
sgx.edmm_enable = false
sgx.enclave_size = "1G"
sgx.max_threads = 8
sgx.remote_attestation = "{{ ra_mode }}"

sgx.trusted_files = [
  "file:/usr/bin/python3.8",
  "file:{{ gramine.runtimedir() }}/",
  "file:/lib/x86_64-linux-gnu/",
  "file:/usr/lib/x86_64-linux-gnu/",
  "file:/usr/lib/python3.8/",
  "file:{{ repo }}/src/core/__init__.py",
{% for name in ['__init__.py','af.py','algebra.py','attestation.py','capability.py','channel.py','credential.py','crypto.py','encoding.py','errors.py','lsss.py','metrics.py','profile.py','publication.py','revocation.py','scheme.py','sealing.py','signing.py','state.py','tee.py','types.py'] %}
  "file:{{ repo }}/src/core/myabe08/{{ name }}",
{% endfor %}
{% for name in ['__init__.py','attestation.py','attested_session.py','messages.py','providers.py','rpc.py','service.py','session.py'] %}
  "file:{{ repo }}/src/core/myabe08/real_tee/{{ name }}",
{% endfor %}
{% for name in ['_cffi_backend.cpython-38-x86_64-linux-gnu.so','typing_extensions.py'] %}
  "file:{{ site }}/{{ name }}",
{% endfor %}
{% for name in ['annotated_types','annotated_types-0.7.0.dist-info','cryptography','cryptography-42.0.8.dist-info','cytoolz','cytoolz-1.0.1.dist-info','eth_hash','eth_hash-0.7.1.dist-info','eth_typing','eth_typing-5.2.1.dist-info','eth_utils','eth_utils-5.3.1.dist-info','py_ecc','py_ecc-8.0.0.dist-info','pydantic','pydantic-2.10.6.dist-info','pydantic_core','pydantic_core-2.27.2.dist-info','toolz','toolz-1.0.0.dist-info','typing_extensions-4.13.2.dist-info'] %}
  "file:{{ site }}/{{ name }}{{ '/' if not name.endswith('.dist-info') else '/' }}",
{% endfor %}
]
